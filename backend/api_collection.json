{
  "info": {
    "name": "Payment Gateway API",
    "description": "Complete API collection for testing the payment gateway backend with Paystack integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "payment_reference",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Info",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "API Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Test User\",\n  \"phone_number\": \"+2348012345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "signup"]
            }
          }
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "signin"]
            }
          }
        },
        {
          "name": "Verify Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-token"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\",\n  \"old_password\": \"password123\",\n  \"new_password\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "change-password"]
            }
          }
        }
      ]
    },
    {
      "name": "C2B - Payment Collection",
      "item": [
        {
          "name": "Initialize Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('payment_reference', jsonData.data.reference);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"amount\": 50000,\n  \"currency\": \"NGN\",\n  \"description\": \"Payment for Order #123\",\n  \"metadata\": {\n    \"order_id\": \"123\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/c2b/initialize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "c2b", "initialize"]
            }
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/c2b/verify/{{payment_reference}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "c2b", "verify", "{{payment_reference}}"]
            }
          }
        },
        {
          "name": "Charge Authorization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"amount\": 50000,\n  \"authorization_code\": \"AUTH_xyz123\",\n  \"currency\": \"NGN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/c2b/charge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "c2b", "charge"]
            }
          }
        },
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/c2b/payments?status=SUCCESS&page=1&per_page=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "c2b", "payments"],
              "query": [
                {
                  "key": "status",
                  "value": "SUCCESS"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "B2C - Payouts & Refunds",
      "item": [
        {
          "name": "Initiate Transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"nuban\",\n  \"name\": \"John Doe\",\n  \"account_number\": \"0123456789\",\n  \"bank_code\": \"058\",\n  \"amount\": 50000,\n  \"currency\": \"NGN\",\n  \"reason\": \"Freelance payment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/b2c/transfer/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "b2c", "transfer", "initiate"]
            }
          }
        },
        {
          "name": "Verify Transfer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/b2c/transfer/verify/TRF-123",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "b2c", "transfer", "verify", "TRF-123"]
            }
          }
        },
        {
          "name": "Process Refund",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_reference\": \"{{payment_reference}}\",\n  \"amount\": 50000,\n  \"currency\": \"NGN\",\n  \"customer_note\": \"Refund for cancelled order\",\n  \"merchant_note\": \"Customer requested cancellation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/b2c/refund",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "b2c", "refund"]
            }
          }
        },
        {
          "name": "List Transfers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/b2c/transfers?status=SUCCESS&page=1&per_page=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "b2c", "transfers"],
              "query": [
                {
                  "key": "status",
                  "value": "SUCCESS"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "List Refunds",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/b2c/refunds?status=SUCCESS&page=1&per_page=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "b2c", "refunds"],
              "query": [
                {
                  "key": "status",
                  "value": "SUCCESS"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Paystack General",
      "item": [
        {
          "name": "Initialize Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"amount\": 10000,\n  \"currency\": \"NGN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/paystack/initialize",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "paystack", "initialize"]
            }
          }
        },
        {
          "name": "Verify Transaction",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/paystack/verify/{{payment_reference}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "paystack", "verify", "{{payment_reference}}"]
            }
          }
        },
        {
          "name": "List Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/paystack/transactions?status=SUCCESS&page=1&per_page=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "paystack", "transactions"],
              "query": [
                {
                  "key": "status",
                  "value": "SUCCESS"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
